# CallmeMaybe configuration.
#
# Every variable below is read somewhere in the code. If you add one that isn't,
# delete it instead — a config key that does nothing is worse than no key.
#
# The only external services this app uses are Shopify and CALL-E. No analytics,
# no error tracker, no email provider, no other paid API.

NODE_ENV=development

# ── Shopify ───────────────────────────────────────────────────
# From your app in the Shopify Partner Dashboard.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Public HTTPS URL of this app. `shopify app dev` sets this for you via its
# tunnel. Also used to build the CALL-E webhook callback URL.
SHOPIFY_APP_URL=
SCOPES=write_products,read_orders,write_orders,read_customers,read_products,read_legal_policies
# Optional: only if your dev store uses a custom domain.
SHOP_CUSTOM_DOMAIN=

# ── Database ──────────────────────────────────────────────────
# Local SQLite file. No hosted database required.
DATABASE_URL=file:dev.sqlite

# ── CALL-E ────────────────────────────────────────────────────
# `fake` uses the fixture provider and places no calls. `calle` uses the real
# API, and ONLY if CALLE_REAL_CALLS_ENABLED is also true — both must be set, so
# a stray CALL_PROVIDER cannot start dialling real numbers by itself.
CALL_PROVIDER=fake
CALLE_REAL_CALLS_ENABLED=false

# From https://dashboard.heycall-e.com/account/api-keys
CALLE_API_KEY=
# Optional. Leave blank to use the SDK default.
CALLE_BASE_URL=

# Unguessable random string. Forms the path of the webhook callback URL, which
# is what authenticates CALL-E's (unsigned) deliveries. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CALLE_WEBHOOK_TOKEN=

# ── Secrets ───────────────────────────────────────────────────
# 32-byte hex. Encrypts phone numbers, transcripts and task text at rest.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=
# Salt for one-way hashes used to match records without storing plaintext.
# Change this and existing hashes stop matching.
HASH_PEPPER=

# ── LLM (optional) ──────────────────────────────────────────────
# When set, task instructions for CALL-E are generated dynamically by an LLM
# instead of the static templates. Falls back to templates if unset or on error.
# DeepSeek (preferred):
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# Or OpenAI-compatible:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# ── Demo ──────────────────────────────────────────────────────
# Both must be E.164 numbers YOU CONTROL.
#
# DEMO_CARRIER_PHONE is the stand-in "carrier support" line for the carrier-trace
# demo. Never point it at a real carrier's support number.
DEMO_CARRIER_PHONE=
DEMO_CUSTOMER_PHONE=
