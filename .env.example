# CallMeMaybe configuration.
#
# Every variable below is read somewhere in the code. If you add one that isn't,
# delete it instead — a config key that does nothing is worse than no key.
#
# The production data path is Shopify -> CallMeMaybe -> CALL-E only. Never add
# real credentials to this file.

NODE_ENV=development
# `hackathon` validates today's CALL-E/Render demo contract. The stricter
# `shopify-app-store` target additionally requires Partner, legal, monitoring,
# support, and status configuration when `bun run validate:release` is run.
RELEASE_TARGET=hackathon

# ── Process/runtime ──────────────────────────────────────────
# Render supplies HOST, PORT, RENDER_SERVICE_NAME, and RENDER_GIT_COMMIT. The
# values below document local defaults; don't override Render's generated
# service metadata in production. CI is normally set by the build runner.
HOST=0.0.0.0
PORT=3000
FRONTEND_PORT=8002
CI=false
RENDER_SERVICE_NAME=
RENDER_GIT_COMMIT=

# ── Shopify ───────────────────────────────────────────────────
# From your app in the Shopify Partner Dashboard.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Public HTTPS URL of this app. `shopify app dev` sets this for you via its
# tunnel. Also used to build the CALL-E webhook callback URL.
SHOPIFY_APP_URL=
SCOPES=read_orders,write_orders,read_legal_policies
# Optional: only if your dev store uses a custom domain.
SHOP_CUSTOM_DOMAIN=

# ── Database ──────────────────────────────────────────────────
# Use a separate PostgreSQL database for every environment.
DATABASE_URL=postgresql://callmemaybe:replace-me@localhost:5432/callmemaybe?schema=public

# ── CALL-E ────────────────────────────────────────────────────
# `fixture` uses deterministic test results and places no calls. `calle` uses the real
# API, and ONLY if CALLE_REAL_CALLS_ENABLED is also true. Both values must be
# exact — the exact string `calle` and the exact string `true` — so a stray or
# mistyped CALL_PROVIDER cannot start dialling real numbers by itself.
CALL_PROVIDER=fixture
CALLE_REAL_CALLS_ENABLED=false

# From https://dashboard.heycall-e.com/account/api-keys
CALLE_API_KEY=
# Optional. If set, this must be the official https://api.heycall-e.com origin.
CALLE_BASE_URL=

# Unguessable random string. Forms the path of the webhook callback URL, which
# is what authenticates CALL-E's (unsigned) deliveries. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CALLE_WEBHOOK_TOKEN=

# ── Secrets ───────────────────────────────────────────────────
# 32-byte hex. Encrypts phone numbers, structured results, and task text at rest.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=
APP_ENCRYPTION_KEY_VERSION=1
# JSON map of prior numeric key versions to 64-character hex keys during rotation.
APP_PREVIOUS_ENCRYPTION_KEYS_JSON={}
# Salt for one-way hashes used to match records without storing plaintext.
# Change this and existing hashes stop matching.
HASH_PEPPER=

# ── Shopify App Pricing and Partner API ──────────────────────
SHOPIFY_APP_GID=
SHOPIFY_PARTNER_ORG_ID=
SHOPIFY_PARTNER_API_TOKEN=
SHOPIFY_APP_EVENTS_API_VERSION=unstable
# Defaults to SHOPIFY_API_KEY/SHOPIFY_API_SECRET when omitted.
SHOPIFY_APP_EVENTS_CLIENT_ID=
SHOPIFY_APP_EVENTS_CLIENT_SECRET=
# Never enable in production.
BILLING_BYPASS_DEVELOPMENT=false

# ── Operations ───────────────────────────────────────────────
SENTRY_DSN=
BETTER_STACK_HEARTBEAT_URL=
LOG_LEVEL=info
PUBLIC_STATUS_URL=
PUBLIC_SUPPORT_EMAIL=
PUBLIC_SECURITY_EMAIL=
# Set only to the counsel-approved published document version.
LEGAL_DOCUMENT_VERSION=

# ── Demo ──────────────────────────────────────────────────────
# Both must be E.164 numbers YOU CONTROL.
#
# DEMO_CARRIER_PHONE is the stand-in "carrier support" line for the carrier-trace
# demo. Never point it at a real carrier's support number.
DEMO_CARRIER_PHONE=
DEMO_CARRIER_NAME=Demo carrier
DEMO_CARRIER_REGION=US
TEST_CARRIER_PHONE=
TEST_CUSTOMER_PHONE=
# The seed command refuses to write demo data unless this explicit guard is on.
DEMO_SEED=false
# Required only for the one-off hackathon seed. The app must already be
# installed on this development store; the seed refuses to invent a shop.
DEMO_SHOP_DOMAIN=
DEMO_STORE_NAME=Northstar Supply Co.
# The standalone /demo/customer route returns 404 unless both are set. Share the
# access token only with reviewers; use a long random value.
DEMO_MODE_ENABLED=false
DEMO_ACCESS_TOKEN=
