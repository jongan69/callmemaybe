// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Shopify Session (scaffold) ──────────────────────────────

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ─── CallMeMaybe Domain Models ───────────────────────────────

model ShopSettings {
  id                            String    @id @default(cuid())
  shopDomain                    String    @unique
  shopifyShopId                 String
  storeName                     String    @default("My Store")
  supportDepartmentName         String    @default("Support")
  agentName                     String    @default("Riley")
  timezone                      String    @default("America/New_York")
  defaultLocale                 String    @default("en-US")
  supportHoursJson              String    @default("{\"start\":\"08:00\",\"end\":\"20:00\",\"timezone\":\"America/New_York\"}")
  humanEscalationEmail          String?
  humanEscalationPhoneEncrypted String?
  globalCallingEnabled          Boolean   @default(false)
  enabledRegionsJson            String    @default("[]")
  businessIdentity              String?
  termsAcceptedAt               DateTime?
  termsVersion                  String?
  confidenceThreshold           Float     @default(0.85)
  maxCallsPerCustomerPerDay     Int       @default(2)
  maxConcurrentCalls            Int       @default(5)
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  policies         SupportPolicy[]
  knowledgeSources KnowledgeSource[]
  supportCases     SupportCase[]
  callConsents     CallConsent[]
  suppressions     SuppressionEntry[]
  subscription     ShopSubscription?
  carrierEndpoints CarrierEndpoint[]
}

model SupportPolicy {
  id                 String   @id @default(cuid())
  shopId             String
  issueType          String
  enabled            Boolean  @default(true)
  mode               String   @default("APPROVAL")
  conditionsJson     String   @default("{}")
  customInstructions String?
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  shop ShopSettings @relation(fields: [shopId], references: [id])

  @@unique([shopId, issueType])
}

model KnowledgeSource {
  id                String    @id @default(cuid())
  shopId            String
  sourceType        String
  externalId        String?
  title             String
  normalizedContent String
  contentHash       String
  appliesToJson     String    @default("[]")
  status            String    @default("active")
  sourceUpdatedAt   DateTime?
  syncedAt          DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  shop ShopSettings @relation(fields: [shopId], references: [id])
}

model SupportCase {
  id                     String    @id @default(cuid())
  publicReference        String    @unique
  shopId                 String
  consentId              String?
  shopifyOrderId         String
  shopifyOrderName       String
  shopifyCustomerId      String
  issueType              String
  customerIssueSummary   String?
  status                 String    @default("REQUESTED")
  resolutionMode         String?
  riskLevel              String?
  customerNameEncrypted  String?
  customerPhoneEncrypted String?
  customerPhoneHash      String?
  customerPhoneLastFour  String?
  orderSnapshotJson      String?
  orderSnapshotHash      String?
  knowledgeSnapshotJson  String?
  policySnapshotJson     String?
  requestedAt            DateTime  @default(now())
  requestExpiresAt       DateTime?
  resolvedAt             DateTime?
  closedAt               DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  shop                  ShopSettings           @relation(fields: [shopId], references: [id])
  consent               CallConsent?           @relation(fields: [consentId], references: [id])
  verificationChallenge VerificationChallenge?
  callPlans             CallPlan[]
  callAttempts          CallAttempt[]
  resolutionProposals   ResolutionProposal[]
  auditEvents           AuditEvent[]

  @@index([shopId, shopifyOrderId])
  @@index([shopId, customerPhoneHash])
}

model CallConsent {
  id                      String    @id @default(cuid())
  shopId                  String
  shopifyOrderId          String
  shopifyCustomerId       String
  purpose                 String
  source                  String
  consentTextVersion      String
  consentText             String
  phoneHash               String
  locale                  String
  region                  String
  maxAttempts             Int       @default(2)
  sessionTokenSubjectHash String?
  ipHash                  String?
  userAgentSummary        String?
  grantedAt               DateTime  @default(now())
  expiresAt               DateTime
  revokedAt               DateTime?
  revocationReason        String?

  shop         ShopSettings  @relation(fields: [shopId], references: [id], onDelete: Cascade)
  supportCases SupportCase[]

  @@index([shopId, shopifyOrderId, shopifyCustomerId])
  @@index([shopId, phoneHash, revokedAt, expiresAt])
}

model SuppressionEntry {
  id          String    @id @default(cuid())
  scope       String
  shopId      String?
  phoneHash   String
  reason      String
  source      String
  effectiveAt DateTime  @default(now())
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  shop ShopSettings? @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([scope, phoneHash])
  @@index([shopId, phoneHash])
}

model RegionPolicy {
  id                            String    @id @default(cuid())
  countryCode                   String
  version                       Int       @default(1)
  countryName                   String
  callingCode                   String
  timezoneStrategy              String    @default("disabled")
  localesJson                   String
  permittedPurposesJson         String
  callWindowStart               String    @default("09:00")
  callWindowEnd                 String    @default("20:00")
  consentTextVersion            String    @default("1.0")
  callScriptVersion             String    @default("1.0")
  aiDisclosureText              String
  suppressionRulesJson          String    @default("{}")
  recordingEnabled              Boolean   @default(false)
  dataRetentionDays             Int       @default(90)
  killSwitchReason              String?
  calleLineId                   String?
  vendorApprovalReference       String?
  legalApprovalReference        String?
  localizationApprovalReference String?
  productionApprovedAt          DateTime?
  legalApprovedAt               DateTime?
  localizationApprovedAt        DateTime?
  effectiveAt                   DateTime?
  disabledAt                    DateTime?
  enabled                       Boolean   @default(false)
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  @@unique([countryCode, version])
  @@index([countryCode, enabled])
}

model CarrierEndpoint {
  id                    String    @id @default(cuid())
  shopId                String
  carrierName           String
  phoneEncrypted        String
  phoneHash             String
  phoneLastFour         String
  countryCode           String
  verificationSource    String
  verificationReference String?
  verifiedBy            String?
  verifiedAt            DateTime?
  enabled               Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  shop ShopSettings @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, phoneHash])
  @@index([shopId, enabled])
}

model VerificationChallenge {
  id                    String    @id @default(cuid())
  supportCaseId         String    @unique
  codeHash              String
  codeEncrypted         String
  expiresAt             DateTime
  maxAttempts           Int       @default(2)
  attemptsUsed          Int       @default(0)
  verifiedAt            DateTime?
  verifiedCallAttemptId String?
  invalidatedAt         DateTime?
  createdAt             DateTime  @default(now())

  supportCase SupportCase @relation(fields: [supportCaseId], references: [id])
}

model CallPlan {
  id                        String  @id @default(cuid())
  supportCaseId             String
  version                   Int     @default(1)
  taskTextEncrypted         String
  resultSchemaJson          String
  recipientResultSchemaJson String?
  metadataJson              String
  idempotencyKey            String  @unique

  // Who this leg dials. CUSTOMER legs dial the phone stored on the support
  // case. THIRD_PARTY legs dial a carrier, courier, or supplier, so they carry
  // their own recipient and are never gated on customer identity verification.
  recipientKind           String    @default("CUSTOMER")
  recipientPhoneEncrypted String?
  recipientLabel          String?
  approvedBy              String?
  approvedAt              DateTime?
  createdAt               DateTime  @default(now())

  supportCase  SupportCase   @relation(fields: [supportCaseId], references: [id])
  callAttempts CallAttempt[]
}

model CallAttempt {
  id                            String    @id @default(cuid())
  supportCaseId                 String
  callPlanId                    String    @unique
  attemptNumber                 Int
  provider                      String    @default("calle")
  providerCallId                String?
  callbackNonceHash             String?
  callbackExpiresAt             DateTime?
  status                        String    @default("PENDING")
  outcome                       String?
  taskCompleted                 Boolean?
  completionConfidenceScore     Float?
  completionConfidenceLabel     String?
  structuredResultJson          String?
  summary                       String?
  evidenceJson                  String?
  providerResponseSanitizedJson String?
  errorCode                     String?
  errorMessage                  String?
  startedAt                     DateTime?
  connectedAt                   DateTime?
  completedAt                   DateTime?
  resultProcessedAt             DateTime?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt

  supportCase SupportCase @relation(fields: [supportCaseId], references: [id])
  callPlan    CallPlan    @relation(fields: [callPlanId], references: [id])
  callEvents  CallEvent[]

  @@unique([provider, providerCallId])
  @@index([supportCaseId, createdAt])
}

model CallEvent {
  id                   String   @id @default(cuid())
  callAttemptId        String
  providerEventId      String
  eventType            String
  eventTime            DateTime
  sequence             Int
  sanitizedPayloadJson String?
  payloadHash          String?
  createdAt            DateTime @default(now())

  callAttempt CallAttempt @relation(fields: [callAttemptId], references: [id])

  @@unique([callAttemptId, providerEventId])
}

model ResolutionProposal {
  id                  String    @id @default(cuid())
  supportCaseId       String
  callAttemptId       String?   @unique
  actionType          String
  status              String    @default("PENDING")
  riskLevel           String?
  policyDecisionJson  String?
  proposedInputJson   String?
  beforeStateJson     String?
  financialImpactJson String?
  requiresApproval    Boolean   @default(true)
  approvedBy          String?
  approvedAt          DateTime?
  rejectedBy          String?
  rejectedAt          DateTime?
  rejectionReason     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  supportCase SupportCase           @relation(fields: [supportCaseId], references: [id])
  executions  ResolutionExecution[]
}

model ResolutionExecution {
  id                   String    @id @default(cuid())
  resolutionProposalId String
  idempotencyKey       String    @unique
  status               String    @default("PENDING")
  shopifyMutation      String?
  requestJson          String?
  responseJson         String?
  userErrorsJson       String?
  beforeStateJson      String?
  afterStateJson       String?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime  @default(now())

  proposal ResolutionProposal @relation(fields: [resolutionProposalId], references: [id])
}

model WebhookReceipt {
  id              String    @id @default(cuid())
  provider        String
  externalEventId String?
  payloadHash     String
  signatureValid  Boolean   @default(false)
  processed       Boolean   @default(false)
  processingError String?
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?

  @@unique([provider, payloadHash])
  @@unique([provider, externalEventId])
}

model CallEligibilityDecision {
  id              String   @id @default(cuid())
  shopId          String
  supportCaseId   String?
  callPlanId      String?
  phoneHash       String?
  region          String?
  purpose         String
  allowed         Boolean
  reasonCodesJson String
  evaluatedAt     DateTime @default(now())

  @@index([shopId, evaluatedAt])
  @@index([supportCaseId])
}

model AuditEvent {
  id            String   @id @default(cuid())
  shopId        String
  supportCaseId String?
  actorType     String
  actorId       String?
  action        String
  resourceType  String
  resourceId    String?
  requestId     String
  beforeHash    String?
  afterHash     String?
  metadataJson  String?
  createdAt     DateTime @default(now())

  supportCase SupportCase? @relation(fields: [supportCaseId], references: [id])
}

model UsageLedger {
  id                     String    @id @default(cuid())
  shopId                 String
  supportCaseId          String?
  callAttemptId          String?   @unique
  usageType              String
  quantity               Int       @default(1)
  unit                   String    @default("call")
  estimatedCostMinor     Int?
  currencyCode           String    @default("USD")
  billingCycleStart      DateTime?
  billingCycleEnd        DateTime?
  included               Boolean   @default(false)
  eventHandle            String?
  shopifyEventId         String?
  shopifyReversalEventId String?
  idempotencyKey         String    @unique
  status                 String    @default("PENDING")
  retryCount             Int       @default(0)
  nextRetryAt            DateTime?
  reportedAt             DateTime?
  validatedAt            DateTime?
  reversedAt             DateTime?
  reversalReceivedAt     DateTime?
  reversalIdempotencyKey String?   @unique
  reversalStatus         String?
  lastError              String?
  occurredAt             DateTime  @default(now())

  @@index([shopId, billingCycleStart, occurredAt])
  @@index([status, nextRetryAt])
}

model ShopSubscription {
  id                   String    @id @default(cuid())
  shopId               String    @unique
  shopifyShopId        String    @unique
  planHandle           String?
  status               String    @default("UNKNOWN")
  billingPeriod        String?
  trialEndsAt          DateTime?
  currentCycleStart    DateTime?
  currentCycleEnd      DateTime?
  cancelAtEndOfCycle   Boolean   @default(false)
  synchronizedAt       DateTime?
  synchronizationError String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  shop ShopSettings @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

// Durable, authenticated privacy work queue. Customer exports are encrypted at
// rest and expire after 30 days; redaction receipts never store raw customer IDs.
model PrivacyRequest {
  id                 String    @id @default(cuid())
  shopDomain         String
  topic              String
  webhookEventIdHash String    @unique
  customerIdHash     String?
  status             String    @default("RECEIVED")
  exportEncrypted    String?
  payloadEncrypted   String?
  errorMessage       String?
  receivedAt         DateTime  @default(now())
  completedAt        DateTime?
  expiresAt          DateTime?

  @@index([shopDomain, receivedAt])
  @@index([shopDomain, customerIdHash])
}
